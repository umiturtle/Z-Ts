# Zig build artifacts
.zig-cache/
zig-out/
# Loose outputs from ad-hoc `zig build-obj` / `zig build-exe` runs (`-Mroot=x.zig` writes the
# binary next to the cwd, which is the repo root).
*.o
/root

# Rust build artifacts
target/

# Node / frontend artifacts
node_modules/
dist/

# Benchmark outputs (M5-03 slice C); CI uploads them as an artifact.
bench/out/
bench-out/

# Editor / OS files
.DS_Store
*.swp
*~

# Generated Python bytecode from the tutorial generator imports.
# scripts/__pycache__/bench-dev-loop.cpython-311.pyc is tracked legacy and stays.
scripts/__pycache__/*.cpython-*.pyc
