#!/usr/bin/env bash
set -euo pipefail

# ./zigw — Zero-config Zig 0.17.0 wrapper for Z-Ts
# 1. Auto-installs Zig 0.17.0 (with bundled LLVM 22 / Clang 22 / LLD) in ~3s if missing.
# 2. Auto-hydrates ~/.cache/zig from GitHub Actions' pre-warmed cache branch (`ci-cache-linux-x64`)
#    on cold sandbox startup, cutting first `zig build` time from ~94s down to ~2s.

ZIG_VERSION="${ZIG_VERSION:-0.17.0}"
FALLBACK_DIR="/tmp/zts-toolchains/zig-${ZIG_VERSION}"

find_zig() {
  if command -v zig >/dev/null 2>&1; then
    local v
    v="$(zig version 2>/dev/null || true)"
    if [[ "$v" == "$ZIG_VERSION" ]]; then
      command -v zig
      return 0
    fi
  fi
  if [[ -x "${FALLBACK_DIR}/ziglang/zig" ]]; then
    echo "${FALLBACK_DIR}/ziglang/zig"
    return 0
  fi
  return 1
}

install_zig_fast() {
  echo "[zigw] Bootstrapping Zig ${ZIG_VERSION} via PyPI wheel..." >&2
  mkdir -p "$FALLBACK_DIR"
  python3 - "$ZIG_VERSION" "$FALLBACK_DIR" << 'EOF'
import json, os, platform, sys, tempfile, urllib.request, zipfile

ver, dst = sys.argv[1], sys.argv[2]
sys_name = platform.system().lower()
machine = platform.machine().lower()

if sys_name == "linux" and machine in ("x86_64", "amd64"):
    match_tokens = ("manylinux", "x86_64")
elif sys_name == "linux" and machine in ("aarch64", "arm64"):
    match_tokens = ("manylinux", "aarch64")
elif sys_name == "darwin" and machine in ("arm64", "aarch64"):
    match_tokens = ("macosx", "arm64")
elif sys_name == "darwin":
    match_tokens = ("macosx", "x86_64")
else:
    raise RuntimeError(f"Unsupported platform: {sys_name}/{machine}")

data = json.loads(urllib.request.urlopen("https://pypi.org/pypi/ziglang/json", timeout=15).read())
wheels = [
    f for f in data["releases"][ver]
    if all(tok in f["filename"] for tok in match_tokens)
]
if not wheels:
    raise RuntimeError(f"No ziglang {ver} wheel found for {sys_name}/{machine}")

with tempfile.NamedTemporaryFile(suffix=".whl", delete=False) as tf:
    whl_path = tf.name

try:
    urllib.request.urlretrieve(wheels[0]["url"], whl_path)
    with zipfile.ZipFile(whl_path) as zf:
        zf.extractall(dst)
finally:
    if os.path.exists(whl_path):
        os.remove(whl_path)

zig_bin = os.path.join(dst, "ziglang", "zig")
os.chmod(zig_bin, 0o755)
EOF

  local zig_bin="${FALLBACK_DIR}/ziglang/zig"
  if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    sudo ln -sf "$zig_bin" /usr/local/bin/zig 2>/dev/null || true
    # Expose bundled Clang 22 wrapper if standalone clang is absent
    if ! command -v clang >/dev/null 2>&1; then
      printf '#!/usr/bin/env bash\nexec zig cc "$@"\n' | sudo tee /usr/local/bin/clang >/dev/null
      printf '#!/usr/bin/env bash\nexec zig c++ "$@"\n' | sudo tee /usr/local/bin/clang++ >/dev/null
      sudo chmod +x /usr/local/bin/clang /usr/local/bin/clang++
    fi
  fi
  echo "$zig_bin"
}

hydrate_ci_cache_if_cold() {
  [[ "${ZTS_SKIP_CACHE_SYNC:-0}" == "1" ]] && return 0
  [[ "$(uname -s)-$(uname -m)" != "Linux-x86_64" ]] && return 0

  # Skip sync for lightweight commands like `version` or `fmt`
  case "${1:-}" in
    version|zen|fmt|targets|env|help|-h|--help) return 0 ;;
  esac

  local cache_dir="${ZIG_GLOBAL_CACHE_DIR:-${HOME}/.cache/zig}"
  [[ -f "${cache_dir}/.zts-hydrated" || -d "${cache_dir}/o" ]] && return 0

  local script_dir repo_slug auth_header=""
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  repo_slug="$(git -C "$script_dir" remote get-url origin 2>/dev/null | sed -E 's#.*github\.com[:/]([^/]+/[^/.]+)(\.git)?$#\1#' || true)"
  [[ -z "$repo_slug" ]] && repo_slug="umiturtle/Z-Ts"

  if command -v gh >/dev/null 2>&1; then
    local tok
    tok="$(gh auth token 2>/dev/null || true)"
    [[ -n "$tok" ]] && auth_header="Authorization: token ${tok}"
  fi

  local tmp_dl
  tmp_dl="$(mktemp -d /tmp/zts-cache-dl.XXXXXX)"
  local url="https://codeload.github.com/${repo_slug}/tar.gz/refs/heads/ci-cache-linux-x64"

  local curl_args=(-fsSL --connect-timeout 3 --max-time 20)
  [[ -n "$auth_header" ]] && curl_args+=(-H "$auth_header")

  if curl "${curl_args[@]}" "$url" -o "${tmp_dl}/branch.tar.gz" 2>/dev/null; then
    mkdir -p "$cache_dir"
    if tar -xzf "${tmp_dl}/branch.tar.gz" --strip-components=1 -C "$tmp_dl" 2>/dev/null \
      && [[ -f "${tmp_dl}/zig-cache.tar.gz" ]]; then
      echo "[zigw] Hydrating pre-warmed Zig global cache from origin/ci-cache-linux-x64..." >&2
      tar -xzf "${tmp_dl}/zig-cache.tar.gz" -C "$cache_dir" 2>/dev/null || true
      touch "${cache_dir}/.zts-hydrated"
    fi
  fi
  rm -rf "$tmp_dl"
}

ZIG_BIN="$(find_zig || install_zig_fast)"
hydrate_ci_cache_if_cold "${1:-}"
exec "$ZIG_BIN" "$@"
